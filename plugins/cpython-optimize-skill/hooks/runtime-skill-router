#!/usr/bin/env bash
# Runtime signal hook for CPython/CinderX optimization workflows.

set -euo pipefail

payload="$(cat || true)"

extract_command() {
    if command -v python3 >/dev/null 2>&1; then
        printf '%s' "$payload" | python3 -c '
import json
import sys

try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)

tool_input = data.get("tool_input") if isinstance(data, dict) else None
if isinstance(tool_input, dict):
    command = tool_input.get("command") or tool_input.get("cmd")
else:
    command = None

if not command and isinstance(data, dict):
    command = data.get("command") or data.get("cmd")

if isinstance(command, str):
    sys.stdout.write(command)
'
    else
        printf '%s' "$payload" | sed -nE 's/.*"(command|cmd)"[[:space:]]*:[[:space:]]*"([^"]*)".*/\2/p' | head -n 1
    fi
}

extract_signal_text() {
    if command -v python3 >/dev/null 2>&1; then
        printf '%s' "$payload" | python3 -c '
import json
import sys

try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)

parts = []

def collect_response(obj):
    if not isinstance(obj, dict):
        return
    for key in ("stdout", "stderr", "output", "error", "message"):
        value = obj.get(key)
        if isinstance(value, str):
            parts.append(value)
    for key in ("tool_response", "tool_output", "response", "result"):
        collect_response(obj.get(key))

collect_response(data)
sys.stdout.write("\n".join(parts))
'
    else
        printf '%s' "$payload" | sed -nE 's/.*"(stdout|stderr|output|error|message)"[[:space:]]*:[[:space:]]*"([^"]*)".*/\2/p'
    fi
}

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

emit_context() {
    local message="$1"
    local escaped
    escaped="$(escape_for_json "$message")"
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "PostToolUse",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"
}

has_signal() {
    local pattern
    for pattern in "$@"; do
        if printf '%s' "$signal_text" | grep -Eiq -- "$pattern"; then
            return 0
        fi
    done
    return 1
}

is_observation_command() {
    local command_text="$1"
    local normalized
    normalized="$(printf '%s' "$command_text" | tr '\n' ' ' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+/ /g')"

    case "$normalized" in
        git\ show*|git\ log*|git\ diff*|git\ grep*|git\ blame*|git\ status*|git\ rev-parse*|git\ ls-files*|git\ reflog*|git\ branch*|git\ stash\ show*)
            return 0
            ;;
        git\ --no-pager\ show*|git\ --no-pager\ log*|git\ --no-pager\ diff*|git\ --no-pager\ blame*)
            return 0
            ;;
        git\ -C\ *\ show*|git\ -C\ *\ log*|git\ -C\ *\ diff*|git\ -C\ *\ blame*)
            return 0
            ;;
        rg*|grep*|sed*|cat*|less*|more*|head*|nl*|wc*|ls*|find*)
            return 0
            ;;
    esac

    return 1
}

command_text="$(extract_command || true)"
signal_text="$(extract_signal_text || true)"
duration_ms="$(printf '%s' "$payload" | sed -nE 's/.*"duration_ms"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' | head -n 1)"

if [ -n "$command_text" ] && is_observation_command "$command_text"; then
    exit 0
fi

if has_signal \
    'SIGSEGV' \
    'Segmentation fault' \
    'signal[[:space:]]+11' \
    'exit[[:space:]]*(status|code)?[[:space:]]*:?[" ]*139' \
    'exit 139' \
    'core dump' \
    'core dumped' \
    'SIGABRT' \
    'Aborted[[:space:]]*\(core dumped\)'
then
    emit_context "检测到 CPython/CinderX native crash 信号（SIGSEGV / exit 139 / core dump）。请加载 workflow-cinderx-crash-triage、cinderx-crash-triager、cinderx-gdb-core-triage 和 cinderx-remote-lab-ops，并按 validation-strategy 选择最低足够验证等级；先保留真实复现命令、stdout/stderr、exit status 和 core，再用 gdb bt full 定位，JIT 相关再补 cinderx-hir-dump / jit.log。日志不能替代 gdb/core/HIR 证据链。"
    exit 0
fi

if has_signal \
    'Command timed out' \
    'timeout' \
    'timed out' \
    'Connection timed out' \
    'Read timed out' \
    'Operation timed out' \
    'Temporary failure in name resolution' \
    'Could not resolve host' \
    'Network is unreachable' \
    'No route to host' \
    'TLS handshake timeout' \
    'pip.*Retrying'
then
    emit_context "检测到 CPython/CinderX 远端 lab 网络/下载异常耗时或 timeout 信号。请加载 cinderx-remote-lab-ops，必要时再进入 workflow-remote-cinderx-lab-setup；先检查进程、日志、exit status、DNS/代理/镜像源/缓存，给命令加 timeout 或复用已有 tmux/日志输出。无法判断是否继续等待时要询问用户。"
    exit 0
fi

if [ -n "$duration_ms" ] && [ "$duration_ms" -ge 120000 ]; then
    if printf '%s' "$payload" | grep -Eq '"stdout"[[:space:]]*:[[:space:]]*""' \
        && printf '%s' "$payload" | grep -Eq '"stderr"[[:space:]]*:[[:space:]]*""'
    then
        emit_context "检测到 CPython/CinderX lab 命令长时间运行后 stdout/stderr 仍为空。请加载 cinderx-remote-lab-ops；先查真实命令、进程、exit status、tmux pane 和日志路径，不要为了补输出盲目重复同一条命令。若怀疑网络卡顿或远程环境异常，及时询问用户。"
        exit 0
    fi
fi

exit 0
